NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Set NEXT_PUBLIC_SUPABASE_ANON_KEY to the Supabase publishable key (sb_publishable_*).
APP_URL=http://localhost:3000
ENABLE_REGISTRATION=false
# Server-only. Never expose through NEXT_PUBLIC_* or browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
HYTECARE_ALLOW_SEED=false
HYTECARE_ALLOWED_SUPABASE_HOSTS=staging-project.supabase.co
HYTECARE_DEMO_PASSWORD=your-secure-demo-password-12-plus
